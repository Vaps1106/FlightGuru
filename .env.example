# Copy this file to ".env" and fill in real values.
# NEVER commit .env — it is listed in .gitignore.
# In GitHub Actions these come from encrypted repository secrets instead.

# --- Providers to use (comma-separated) ---
PROVIDERS=duffel,serpapi

# --- Duffel (free signup at https://app.duffel.com) ---
DUFFEL_ACCESS_TOKEN=your_duffel_access_token_here
DUFFEL_VERSION=v2

# --- SerpApi / Google Flights (free tier ~100 searches/month) ---
SERPAPI_API_KEY=your_serpapi_key_here
SERPAPI_MAX_DATES=8            # cap SerpApi to N dates/run to protect its quota

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
NOTIFY_EVERY_RUN=true         # false = only message on below-target / price drop

# --- Search parameters ---
ORIGIN=BOM
DESTINATION=JFK
SEARCH_START_DATE=2026-07-20   # earliest departure date to check
SEARCH_END_DATE=2026-08-14     # latest departure date to check
SEARCH_DATE_STEP=1             # days between dates (increase to use fewer calls)
TARGET_PRICE=700
CURRENCY=USD
