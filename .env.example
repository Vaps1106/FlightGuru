# Copy this file to ".env" and fill in real values.
# NEVER commit .env — it is listed in .gitignore.
# On Railway these are set as service variables instead.

# --- Telegram (required) ---
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Who is allowed to talk to the bot. Message the bot and check the logs to find
# your chat id. Several ids can be comma-separated.
#
# Leave this empty and the bot ignores everyone — deliberately, so a token that
# leaks cannot be used to burn your search quota. Set it to * to allow anyone,
# which only makes sense for a throwaway bot.
TELEGRAM_CHAT_ID=your_chat_id_here

# --- SerpApi / Google Flights (required to search) ---
# Free tier is about 100 searches a month. One trip search costs one search,
# however many airports it covers — repeats within an hour come from cache free.
SERPAPI_API_KEY=your_serpapi_key_here

# --- Search behaviour (optional; these are the defaults) ---
CURRENCY=USD

# Nearby-airport comparison. The radius is in miles, roughly a two-hour drive.
# This is what surfaces Avelo out of New Haven or Breeze out of Portsmouth.
NEARBY_ENABLED=true
NEARBY_RADIUS_MILES=100

# Also check airports near the destination. Off by default — it widens results a
# lot and most people care more about where they leave from.
NEARBY_DESTINATION=false

# How long each Telegram long-poll waits, in seconds. Telegram allows up to 50.
POLL_TIMEOUT=30
